<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Blokir akses langsung ke file sensitif dan konfigurasi di root
    RewriteRule ^(?:AGENTS\.md|DESIGN\.md|README\.md|konsep_crm_layanan_mahasiswa_unpam\.md|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|postcss\.config\.js|tailwind\.config\.js|vite\.config\.js|\.env.*|\.git.*|\.editorconfig)$ - [F,L,NC]

    # Blokir akses langsung ke direktori internal framework
    RewriteRule ^(?:app|bootstrap|config|database|node_modules|resources|routes|storage|tests|vendor)(?:/.*)?$ - [F,L,NC]

    # Teruskan aset statis (build Vite, favicon, robots.txt) ke folder public/ kecuali index.php
    RewriteCond $1 !^index\.php$ [NC]
    RewriteCond %{REQUEST_URI} !^/crm_layanan_mahasiswa/public/ [NC]
    RewriteCond %{DOCUMENT_ROOT}/crm_layanan_mahasiswa/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # Teruskan Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Arahkan seluruh request aplikasi ke front controller index.php di root
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
